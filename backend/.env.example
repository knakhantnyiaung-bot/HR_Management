NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://hr_payroll:hr_payroll_dev@localhost:5432/hr_payroll?schema=public"

# Auth
# Required — the app now fails to start without it (no insecure fallback).
# Generate a real value per environment, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Candidate portal auth (Sprint 3 Wave 1, CAREER-03/04). Required — same
# fail-fast rule as JWT_SECRET, and deliberately a DIFFERENT value: a
# candidate token must be structurally incapable of passing requireAuth.
CANDIDATE_JWT_SECRET=change-me-in-production-too
CANDIDATE_JWT_EXPIRES_IN=8h

# Comma-separated allowlist of origins allowed to call this API.
# Required in production (no default there); dev/test default to the Vite
# dev server (http://localhost:5174) if left unset.
CORS_ORIGIN=http://localhost:5174

# Org defaults (Appendix / HLD section 2)
DEFAULT_TIMEZONE=Asia/Yangon
DEFAULT_CURRENCY=MMK

# Push notifications (Sprint 3 Wave 1, NOTIF-08..13) — optional. A VAPID
# key pair (plain EC P-256, no vendor account). Only the public key is read
# by the backend today (handed to the browser's PushManager.subscribe());
# the private key isn't used until a real PushProvider replaces the
# console-log stub in common/notifications/pushProvider.ts and needs to
# sign outgoing push requests. Generate a pair with:
#   node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();const b=x=>x.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');console.log('VAPID_PUBLIC_KEY='+b(e.getPublicKey()));console.log('VAPID_PRIVATE_KEY='+b(e.getPrivateKey()));"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
