NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://hr_payroll:hr_payroll_dev@localhost:5432/hr_payroll?schema=public"

# Auth
# Required — the app now fails to start without it (no insecure fallback).
# Generate a real value per environment, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Candidate portal auth (Sprint 3 Wave 1, CAREER-03/04). Required — same
# fail-fast rule as JWT_SECRET, and deliberately a DIFFERENT value: a
# candidate token must be structurally incapable of passing requireAuth.
CANDIDATE_JWT_SECRET=change-me-in-production-too
CANDIDATE_JWT_EXPIRES_IN=8h

# Comma-separated allowlist of origins allowed to call this API.
# Required in production (no default there); dev/test default to the Vite
# dev server (http://localhost:5174) if left unset.
CORS_ORIGIN=http://localhost:5174

# Org defaults (Appendix / HLD section 2)
DEFAULT_TIMEZONE=Asia/Yangon
DEFAULT_CURRENCY=MMK

# Push notifications (Sprint 3 Wave 1, NOTIF-08..13) — optional. A VAPID
# key pair (plain EC P-256, no vendor account). Only the public key is read
# by the backend today (handed to the browser's PushManager.subscribe());
# the private key isn't used until a real PushProvider replaces the
# console-log stub in common/notifications/pushProvider.ts and needs to
# sign outgoing push requests. Generate a pair with:
#   node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();const b=x=>x.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');console.log('VAPID_PUBLIC_KEY='+b(e.getPublicKey()));console.log('VAPID_PRIVATE_KEY='+b(e.getPrivateKey()));"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Calendar integration (Sprint 3 Wave 1, CAL-01..07) — optional,
# org-level, org-connects-once (Sprint 3 HLD §8). Without these set, the
# "Connect Google Calendar" action in org settings returns a clear error;
# everything else keeps working exactly as before (interview scheduling
# just doesn't create a calendar event).
#
# To get GOOGLE_CLIENT_ID/SECRET: console.cloud.google.com -> create/select
# a project -> APIs & Services -> enable "Google Calendar API" -> Credentials
# -> Create Credentials -> OAuth client ID (type: Web application) -> add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/organization/calendar-integration/callback
# AES-256-GCM key (32 bytes, hex) for encrypting stored OAuth tokens — no
# Google account needed, generate with: openssl rand -hex 32
CALENDAR_TOKEN_ENC_KEY=

# AI HR assistant (Sprint 3 Wave 3, AI-01..05) — optional, read-only Q&A
# over the asking employee's own HR data (Sprint 3 HLD Appendix A: starts
# narrow regardless of eventual ambition — no write actions, no other
# employees' data). Without a key, POST /ai/chat returns a clear
# config-missing error; everything else keeps working. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
