// HR & Payroll Management Platform — Sprint 1 MVP
// Schema derived from HLD Appendix A (Core Data Entities) and Appendix C (State Machines).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (state machines — HLD Appendix C)
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  // Sprint 2 §10/§3.1 — scoped to assigned recruitment pipeline items only;
  // never has salary, offer, or unassigned-candidate visibility. See
  // recruitment.service.ts for the resource-scope check this role requires
  // in addition to the ordinary role check.
  HIRING_MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  DRAFT
  ACTIVE
  INACTIVE
  TERMINATED
}

enum WorkModel {
  OFFICE
  HYBRID
  REMOTE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

// HLD v1.1 section 11.3 — GPS is optional on every check-in/check-out.
// GPS = coordinates captured from the client; UNAVAILABLE = none captured
// (denied, timed out, unsupported, or capture disabled for the org).
enum LocationSource {
  GPS
  MANUAL
  UNAVAILABLE
}

// ---------------------------------------------------------------------------
// Sprint 2 enums — HLD §11/§12/§13/§14, Handbook GEO-*/NOTIF-*/EXP-*/REC-*
// ---------------------------------------------------------------------------

// Sprint 2 HLD §11.1 — replaces Organization.locationCaptureEnabled (v1.1).
// Migration backfill: locationCaptureEnabled=true -> LOG_ONLY, false -> NONE.
enum LocationPolicy {
  NONE
  LOG_ONLY
  GEOFENCE_ENFORCED
}

// ---------------------------------------------------------------------------
// Sprint 3 Wave 1 enums — HLD §5, Handbook GEO-10..13
// ---------------------------------------------------------------------------

// GEO-10 — a zone is either a circle (lat/lng/radiusMeters, Sprint 2) or a
// polygon (an ordered vertex list, Sprint 3). Additive: existing rows are
// backfilled to CIRCLE, no data migration of their lat/lng/radius values.
enum GeofenceShape {
  CIRCLE
  POLYGON
}

// HLD Appendix C — notification outbox delivery state.
enum NotificationEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// HLD Appendix C — expense claim lifecycle.
enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
  CANCELLED
}

// EXP-09..11 — how a standalone (non-payroll-cycle) reimbursement was paid.
// Recorded manually by HR in Sprint 3 Wave 1; Wave 3's bank disbursement
// integration is expected to fill these same fields from a real API
// response instead (Sprint 3 HLD §7), so no schema change there.
enum DisbursementMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  OTHER
}

enum JobPostingStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

// HLD Appendix C — candidate pipeline stage. REJECTED/WITHDRAWN are terminal
// from any stage (REC-02); all others are forward-only.
enum CandidateApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  ONSITE
  REMOTE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// HLD Appendix C — offer lifecycle.
enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  RESCINDED
}

// ---------------------------------------------------------------------------
// Organization & identity
// ---------------------------------------------------------------------------

model Organization {
  id             String         @id @default(uuid())
  name           String
  timezone       String         @default("Asia/Yangon")
  currency       String         @default("MMK")
  payrollCycle   String         @default("MONTHLY") @map("payroll_cycle")
  // Sprint 2 HLD §11.1 — replaces v1.1's locationCaptureEnabled boolean.
  // NONE = old false, LOG_ONLY = old true (default; matches v1.1 behavior
  // exactly), GEOFENCE_ENFORCED = new hard rejection for OFFICE employees.
  locationPolicy LocationPolicy @default(LOG_ONLY) @map("location_policy")
  status         String         @default("ACTIVE")
  // CAREER-01/09 — opt-in public careers page. No careersSlug means no
  // public page at all (404), not an empty one — an org that existed
  // before Sprint 3 isn't unexpectedly exposed. Super Admin sets both via
  // PATCH /organization.
  careersSlug    String?        @unique @map("careers_slug")
  careersEnabled Boolean        @default(false) @map("careers_enabled")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  users               User[]
  departments         Department[]
  positions           Position[]
  employees           Employee[]
  attendanceRecords   AttendanceRecord[]
  leaveTypes          LeaveType[]
  payrollRuns         PayrollRun[]
  auditLogs           AuditLog[]
  geofenceZones       GeofenceZone[]
  notificationEvents  NotificationEvent[]
  notifications       Notification[]
  expenseCategories   ExpenseCategory[]
  expenseClaims       ExpenseClaim[]
  jobPostings         JobPosting[]
  candidates          Candidate[]
  calendarIntegration CalendarIntegration?

  @@map("organizations")
}

model User {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  email          String
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(EMPLOYEE)
  status         UserStatus @default(ACTIVE)
  // NOTIF-08..13 — SMS delivery target, E.164 (e.g. +959123456789).
  // Self-service via PATCH /auth/me; lives on User (not Employee) so
  // HR Admin/Super Admin/Hiring Manager accounts without an Employee row
  // can still set one.
  phoneNumber    String?    @map("phone_number")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization                  Organization             @relation(fields: [organizationId], references: [id])
  employee                      Employee?
  auditLogs                     AuditLog[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  pushSubscriptions             PushSubscription[]
  hiringManagerApplications     CandidateApplication[]
  connectedCalendarIntegrations CalendarIntegration[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Org structure
// ---------------------------------------------------------------------------

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  positions    Position[]
  employees    Employee[]
  jobPostings  JobPosting[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Position {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  departmentId   String   @map("department_id")
  title          String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  jobPostings  JobPosting[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("positions")
}

// ---------------------------------------------------------------------------
// Employee
// ---------------------------------------------------------------------------

model Employee {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @unique @map("user_id")
  employeeNo     String         @map("employee_no")
  joinDate       DateTime       @map("join_date") @db.Date
  departmentId   String         @map("department_id")
  positionId     String         @map("position_id")
  workModel      WorkModel      @default(OFFICE) @map("work_model")
  status         EmployeeStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  position     Position     @relation(fields: [positionId], references: [id])

  attendanceRecords AttendanceRecord[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  overtimeRequests  OvertimeRequest[]
  salaryProfiles    SalaryProfile[]
  payrollItems      PayrollItem[]
  expenseClaims     ExpenseClaim[]

  @@unique([organizationId, employeeNo])
  @@index([organizationId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  employeeId        String         @map("employee_id")
  workDate          DateTime       @map("work_date") @db.Date
  checkIn           DateTime       @map("check_in")
  checkOut          DateTime?      @map("check_out")
  workingMinutes    Int?           @map("working_minutes")
  correctedBy       String?        @map("corrected_by")
  correctionNote    String?        @map("correction_note")
  // HLD v1.1 section 11.3/11.4, Handbook v1.1 ATT-09..ATT-13 — optional GPS
  // capture per event. Nullable: a record with no location is the expected
  // common case, not an error state. Never used to reject a check-in/out.
  checkInLat        Float?         @map("check_in_lat")
  checkInLng        Float?         @map("check_in_lng")
  checkInAccuracyM  Int?           @map("check_in_accuracy_m")
  checkOutLat       Float?         @map("check_out_lat")
  checkOutLng       Float?         @map("check_out_lng")
  checkOutAccuracyM Int?           @map("check_out_accuracy_m")
  locationSource    LocationSource @default(UNAVAILABLE) @map("location_source")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId, workDate])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  paid           Boolean  @default(true)
  policySettings Json?    @map("policy_settings")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@index([organizationId])
  @@map("leave_types")
}

model LeaveBalance {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  leaveTypeId String   @map("leave_type_id")
  period      String
  entitled    Decimal  @default(0) @db.Decimal(6, 2)
  used        Decimal  @default(0) @db.Decimal(6, 2)
  remaining   Decimal  @default(0) @db.Decimal(6, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, period])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String        @id @default(uuid())
  employeeId  String        @map("employee_id")
  leaveTypeId String        @map("leave_type_id")
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  days        Decimal       @db.Decimal(5, 2)
  status      RequestStatus @default(PENDING)
  approvedBy  String?       @map("approved_by")
  approvedAt  DateTime?     @map("approved_at")
  reason      String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Overtime
// ---------------------------------------------------------------------------

model OvertimeRequest {
  id         String        @id @default(uuid())
  employeeId String        @map("employee_id")
  workDate   DateTime      @map("work_date") @db.Date
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  hours      Decimal       @db.Decimal(5, 2)
  multiplier Decimal       @default(1.5) @db.Decimal(3, 2)
  status     RequestStatus @default(PENDING)
  approvedBy String?       @map("approved_by")
  approvedAt DateTime?     @map("approved_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("overtime_requests")
}

// ---------------------------------------------------------------------------
// Salary
// ---------------------------------------------------------------------------

model SalaryProfile {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  basicSalary   Decimal   @map("basic_salary") @db.Decimal(14, 2)
  allowances    Json      @default("{}")
  deductions    Json      @default("{}")
  otSettings    Json?     @map("ot_settings")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("salary_profiles")
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  period         String
  status         PayrollRunStatus @default(DRAFT)
  totals         Json?
  approvedBy     String?          @map("approved_by")
  approvedAt     DateTime?        @map("approved_at")
  paidAt         DateTime?        @map("paid_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        PayrollItem[]

  @@unique([organizationId, period])
  @@map("payroll_runs")
}

model PayrollItem {
  id            String   @id @default(uuid())
  payrollRunId  String   @map("payroll_run_id")
  employeeId    String   @map("employee_id")
  snapshotInput Json     @map("snapshot_input")
  earnings      Decimal  @db.Decimal(14, 2)
  deductions    Decimal  @db.Decimal(14, 2)
  gross         Decimal  @db.Decimal(14, 2)
  net           Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payrollRun    PayrollRun     @relation(fields: [payrollRunId], references: [id])
  employee      Employee       @relation(fields: [employeeId], references: [id])
  payslip       Payslip?
  expenseClaims ExpenseClaim[]

  @@unique([payrollRunId, employeeId])
  @@map("payroll_items")
}

model Payslip {
  id            String   @id @default(uuid())
  payrollItemId String   @unique @map("payroll_item_id")
  releasedAt    DateTime @default(now()) @map("released_at")
  documentRef   String?  @map("document_ref")
  createdAt     DateTime @default(now()) @map("created_at")

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])

  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Sprint 2 — Geofence Enforcement (HLD §11, Handbook §6 GEO-*)
// ---------------------------------------------------------------------------

// GEO-10..13 — lat/lng/radiusMeters are CIRCLE-only and now optional;
// polygon is POLYGON-only. Which fields are required for a given shape is
// enforced in geofence.schema.ts/geofence.service.ts, not a DB constraint —
// same choice Sprint 2 made for REC-03/REC-05 rather than a partial check
// constraint.
model GeofenceZone {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  label          String
  shape          GeofenceShape @default(CIRCLE)
  lat            Float?
  lng            Float?
  radiusMeters   Int?          @map("radius_meters")
  // GEO-10 — ordered [{lat,lng}, ...] vertex list, 3-50 points. Stored as
  // JSON rather than a child table: a zone's own vertex order matters and
  // is always read/written as one unit, never queried per-vertex.
  polygon        Json?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("geofence_zones")
}

// ---------------------------------------------------------------------------
// Sprint 2 — Notifications (HLD §12, Handbook §7 NOTIF-*)
// ---------------------------------------------------------------------------

// Transactional outbox row — written inside the same transaction as the
// business action it announces (NOTIF-01). Drained by an in-process
// dispatcher (notification.queue.ts); see ADR-011/012 deviation note in the
// Sprint 2 implementation plan for why this is not a Redis/BullMQ queue.
model NotificationEvent {
  id             String                  @id @default(uuid())
  organizationId String                  @map("organization_id")
  eventType      String                  @map("event_type")
  payload        Json
  status         NotificationEventStatus @default(PENDING)
  attempts       Int                     @default(0)
  lastError      String?                 @map("last_error")
  // Appendix C backoff formula — the dispatcher skips a PENDING row until
  // this time, instead of retrying it on every poll tick.
  nextAttemptAt  DateTime                @default(now()) @map("next_attempt_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  processedAt    DateTime?               @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([organizationId])
  @@map("notification_events")
}

model Notification {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  userId              String    @map("user_id")
  eventType           String    @map("event_type")
  title               String
  message             String
  relatedResourceType String?   @map("related_resource_type")
  relatedResourceId   String?   @map("related_resource_id")
  readAt              DateTime? @map("read_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([organizationId])
  @@map("notifications")
}

// NOTIF-05 — per-user, per-event-type email opt-out. In-app delivery cannot
// be disabled, so there is deliberately no inAppEnabled column.
model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  eventType    String  @map("event_type")
  emailEnabled Boolean @default(true) @map("email_enabled")
  // NOTIF-08..13 — same per-user/per-event-type opt-out shape as
  // emailEnabled. In-app delivery is still never disableable (no
  // inAppEnabled column, per NOTIF-05).
  smsEnabled   Boolean @default(true) @map("sms_enabled")
  pushEnabled  Boolean @default(true) @map("push_enabled")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

// NOTIF-08..13 — a browser Web Push subscription (endpoint + encryption
// keys), one row per device/browser a user has enabled push on. Delivery
// itself goes through PushProvider (backend/src/common/notifications/) —
// this table only tracks who to deliver to.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Sprint 2 — Expense Claims (HLD §13, Handbook §8 EXP-*)
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id              String  @id @default(uuid())
  organizationId  String  @map("organization_id")
  name            String
  requiresReceipt Boolean @default(false) @map("requires_receipt")
  status          String  @default("ACTIVE")

  organization Organization   @relation(fields: [organizationId], references: [id])
  claims       ExpenseClaim[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("expense_categories")
}

// EXP-01..EXP-08 — DRAFT -> SUBMITTED -> APPROVED -> REIMBURSED, or REJECTED
// / CANCELLED. payrollItemId is set only on reimbursement (EXP-05/06/07);
// deliberately not unique — every approved claim reimbursed in the same
// employee/period payroll calculation shares one PayrollItem snapshot.
model ExpenseClaim {
  id                    String              @id @default(uuid())
  organizationId        String              @map("organization_id")
  employeeId            String              @map("employee_id")
  categoryId            String              @map("category_id")
  amount                Decimal             @db.Decimal(14, 2)
  expenseDate           DateTime            @map("expense_date") @db.Date
  description           String?
  status                ExpenseClaimStatus  @default(DRAFT)
  rejectionReason       String?             @map("rejection_reason")
  approvedBy            String?             @map("approved_by")
  approvedAt            DateTime?           @map("approved_at")
  payrollItemId         String?             @map("payroll_item_id")
  // EXP-09..11 — set only when a claim is reimbursed standalone (outside a
  // payroll run), mutually exclusive with payrollItemId: exactly one of the
  // two paths to REIMBURSED applies to a given claim, enforced in
  // expenses.service.ts.
  disbursementMethod    DisbursementMethod? @map("disbursement_method")
  disbursementReference String?             @map("disbursement_reference")
  disbursedAt           DateTime?           @map("disbursed_at")
  disbursedBy           String?             @map("disbursed_by")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  employee     Employee         @relation(fields: [employeeId], references: [id])
  category     ExpenseCategory  @relation(fields: [categoryId], references: [id])
  payrollItem  PayrollItem?     @relation(fields: [payrollItemId], references: [id])
  receipts     ExpenseReceipt[]

  @@index([organizationId])
  @@index([employeeId, status])
  @@index([payrollItemId])
  @@map("expense_claims")
}

// File reference only (storage key + metadata) — the binary lives in the
// StorageAdapter (local disk in Sprint 2, S3-swappable later), never in
// Postgres. See Handbook §13/DB2-06.
model ExpenseReceipt {
  id             String   @id @default(uuid())
  expenseClaimId String   @map("expense_claim_id")
  storageKey     String   @map("storage_key")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")

  expenseClaim ExpenseClaim @relation(fields: [expenseClaimId], references: [id])

  @@index([expenseClaimId])
  @@map("expense_receipts")
}

// ---------------------------------------------------------------------------
// Sprint 2 — Recruitment / ATS (HLD §14/§15, Handbook §9/§10 REC-*/HANDOFF-*)
// ---------------------------------------------------------------------------

model JobPosting {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  title          String
  departmentId   String           @map("department_id")
  positionId     String           @map("position_id")
  employmentType String           @map("employment_type")
  openings       Int              @default(1)
  status         JobPostingStatus @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  department   Department             @relation(fields: [departmentId], references: [id])
  position     Position               @relation(fields: [positionId], references: [id])
  applications CandidateApplication[]

  @@index([organizationId])
  @@map("job_postings")
}

// REC-01 — HR/Recruiter-entered only in Sprint 2, no public intake endpoint.
// convertedEmployeeId is set once, on successful conversion (HANDOFF-04),
// and is the permanent traceability link back to the resulting Employee.
model Candidate {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  fullName            String   @map("full_name")
  email               String
  phone               String?
  resumeStorageKey    String?  @map("resume_storage_key")
  resumeFileName      String?  @map("resume_file_name")
  source              String?
  convertedEmployeeId String?  @map("converted_employee_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id])
  applications  CandidateApplication[]
  portalAccount CandidatePortalAccount?

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("candidates")
}

// CAREER-03/04 — a Candidate can exist without a portal account (Sprint 2's
// HR-entered candidates stay valid); this row is only created the first
// time someone registers through the public careers flow. Deliberately not
// a User: candidate identity/auth (careers.service.ts, requireCandidateAuth)
// is fully separate from internal RBAC, signed with its own JWT secret —
// see Sprint 3 HLD §3.
enum CandidatePortalStatus {
  ACTIVE
  INACTIVE
}

model CandidatePortalAccount {
  id           String                @id @default(uuid())
  candidateId  String                @unique @map("candidate_id")
  passwordHash String                @map("password_hash")
  status       CandidatePortalStatus @default(ACTIVE)
  lastLoginAt  DateTime?             @map("last_login_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id])

  @@map("candidate_portal_accounts")
}

// REC-02/REC-03 — forward-only stage machine, terminal REJECTED/WITHDRAWN
// from any stage. Duplicate-open-application (REC-03) and single-active-
// offer (REC-05) are enforced in recruitment.service.ts inside a locked
// transaction rather than as a DB constraint — see the Sprint 2 plan's note
// on why a partial-unique index isn't used here.
model CandidateApplication {
  id                  String                    @id @default(uuid())
  candidateId         String                    @map("candidate_id")
  jobPostingId        String                    @map("job_posting_id")
  stage               CandidateApplicationStage @default(APPLIED)
  // References User.id (not Employee) — REC-06: any Hiring Manager account
  // can be assigned regardless of whether it also has an Employee record.
  hiringManagerUserId String?                   @map("hiring_manager_user_id")
  stageUpdatedAt      DateTime                  @default(now()) @map("stage_updated_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  candidate     Candidate   @relation(fields: [candidateId], references: [id])
  jobPosting    JobPosting  @relation(fields: [jobPostingId], references: [id])
  hiringManager User?       @relation(fields: [hiringManagerUserId], references: [id])
  interviews    Interview[]
  offers        Offer[]

  @@index([candidateId])
  @@index([jobPostingId])
  @@index([hiringManagerUserId])
  @@map("candidate_applications")
}

model Interview {
  id              String          @id @default(uuid())
  applicationId   String          @map("application_id")
  scheduledAt     DateTime        @map("scheduled_at")
  mode            InterviewMode   @default(ONSITE)
  // CAL-01..07 — replaces Sprint 2's free-text interviewerNames (no
  // calendar integration then). Structured [{name, email}] — email is what
  // lets CalendarProvider add real attendees to the Google Calendar event;
  // a Sprint 2 interview's interviewerNames is migrated in with email left
  // null (no calendar invite for a past interview, which is correct).
  interviewers    Json            @default("[]")
  // Set once a calendar event is created for this interview (only when the
  // org has an ACTIVE CalendarIntegration); used to update/cancel the same
  // event later instead of creating duplicates.
  calendarEventId String?         @map("calendar_event_id")
  feedback        String?
  score           Int?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  application CandidateApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@map("interviews")
}

// CAL-01..07 — one Google account/calendar per org (Sprint 3 HLD §8: a
// shared account like recruiting@, not per-interviewer OAuth). Tokens are
// encrypted at rest (AES-256-GCM, common/crypto/tokenCrypto.ts) — the first
// at-rest secret encryption in this codebase; passwords use bcrypt hashing,
// which is one-way and doesn't apply here since the raw token must be
// recoverable to call the Google API.
model CalendarIntegration {
  id                String   @id @default(uuid())
  organizationId    String   @unique @map("organization_id")
  provider          String   @default("GOOGLE")
  accessTokenEnc    String   @map("access_token_enc")
  refreshTokenEnc   String   @map("refresh_token_enc")
  expiresAt         DateTime @map("expires_at")
  calendarId        String   @map("calendar_id")
  connectedByUserId String   @map("connected_by_user_id")
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  connectedBy  User         @relation(fields: [connectedByUserId], references: [id])

  @@map("calendar_integrations")
}

// REC-04/REC-05 — only HR Admin/Super Admin create/send/rescind an offer;
// at most one non-terminal (DRAFT/SENT) offer per application, enforced in
// the service layer.
model Offer {
  id             String      @id @default(uuid())
  applicationId  String      @map("application_id")
  proposedSalary Decimal     @map("proposed_salary") @db.Decimal(14, 2)
  currency       String
  startDate      DateTime    @map("start_date") @db.Date
  status         OfferStatus @default(DRAFT)
  sentAt         DateTime?   @map("sent_at")
  respondedAt    DateTime?   @map("responded_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  application CandidateApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@map("offers")
}
