# Variables consumed by docker-compose.yml. Copy to .env in this directory
# (docker compose loads it automatically) and fill in real values before
# running `docker compose up` — the required ones have no insecure fallback
# and compose will refuse to start without them.

# Postgres
POSTGRES_USER=hr_payroll
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hr_payroll

# Auth — required, generate per environment: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Must be a different value than JWT_SECRET (see backend/.env.example).
CANDIDATE_JWT_SECRET=
CANDIDATE_JWT_EXPIRES_IN=8h

# Comma-separated allowlist of origins allowed to call the API.
CORS_ORIGIN=https://your-frontend-domain.example

# Org defaults
DEFAULT_TIMEZONE=Asia/Yangon
DEFAULT_CURRENCY=MMK

# Push notifications — optional, see backend/.env.example for how to
# generate a VAPID key pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Calendar integration — optional, see backend/.env.example.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDAR_TOKEN_ENC_KEY=

# AI HR assistant — optional, see backend/.env.example.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
